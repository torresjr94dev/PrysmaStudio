# Copia este archivo como deploy/.env y ajusta los valores.
PRYSMA_DOMAIN=pdf.tudominio.mx
# Obligatorio por la AGPL-3.0: URL pública del código fuente que corre en tu servidor.
PRYSMA_SOURCE_URL=https://github.com/torresjr94dev/PrysmaStudio

# Opcional: instancia privada. Genera una llave y su hash con:
#   python3 -c "import secrets,hashlib; k=secrets.token_urlsafe(24); print(k); print(hashlib.sha256(k.encode()).hexdigest())"
# Reparte la llave (primera línea) y pon aquí solo el hash (segunda línea). Varias separadas por comas.
PRYSMA_ACCESS_KEYS_SHA256=

PRYSMA_MAX_UPLOAD_MB=100
PRYSMA_MAX_PAGES=300
PRYSMA_MAX_CONCURRENT_JOBS=2
PRYSMA_JOBS_PER_MINUTE_PER_IP=10
PRYSMA_WORK_TMPFS=2g

# Opcional: detrás de un nginx/proxy que ya ocupa 80/443 y termina el TLS (ver nginx.conf.example).
#PRYSMA_SITE_SCHEME=http://
#PRYSMA_TRUSTED_PROXIES=private_ranges
#PRYSMA_BIND_ADDR=127.0.0.1
#PRYSMA_HTTP_PORT=8090
#PRYSMA_HTTPS_PORT=8453
